// use prisma-8 

model Categories {
  id           Int       @id @default(autoincrement())
  categoryName VarChar(255)
  description  VarChar(255)
  Product      Product[]
}

model OrderItens {
  id        Int      @id @default(autoincrement())
  idOrder   Int
  idVariant Int
  quantity  Int
  unitPrice Int
  Orders    Orders   @relation(fields: [idOrder], references: [id])
  Variants  Variants @relation(fields: [idVariant], references: [id])
}

model Orders {
  id          Int          @id @default(autoincrement())
  idUser      Int
  orderDate   TimestamptzString
  orderStatus Status       @default(PENDING)
  OrderItens  OrderItens[]
  User        User         @relation(fields: [idUser], references: [id])
  Payment     Payment[]
}

model Payment {
  id                   Int      @id @default(autoincrement())
  idUser               Int
  idOrder              Int
  paymentDate          TimestamptzString
  paymentMetod         Methods
  paymentStatus        Status
  id_transacao_gateway String?
  Orders               Orders   @relation(fields: [idOrder], references: [id])
  User                 User     @relation(fields: [idUser], references: [id])
}

model Product {
  id          Int        @id @default(autoincrement())
  name        VarChar(255)
  idCategory  Int
  price       Int
  stock       Int
  description VarChar(255)
  Categories  Categories @relation(fields: [idCategory], references: [id])
  Variants    Variants[]
}

model User {
  id       Int       @id @default(autoincrement())
  email    VarChar(150)    @unique
  name     VarChar(100)
  adress   VarChar(255)
  password String
  userName String    @unique
  Orders   Orders[]
  Payment  Payment[]
}

model Variants {
  id          Int          @id @default(autoincrement())
  name VarChar(255)
  idProduct   Int
  color       VarChar(255)
  stock       Int
  variantCode Int
  OrderItens  OrderItens[]
  Product     Product      @relation(fields: [idProduct], references: [id])
}

enum Methods {
  @@type("pg/text@1")
  PIX = "pix"
  CARTAO = "cartão"
  BOLETO = "boleto"
  PAYPAL = "paypal"
}

enum Status {
  @@type("pg/text@1")
  COMPLETED = "concluído"
  PENDING = "em processo"
  REFUSED = "recusado"
}
