    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.0.1",
    "@prisma/cli-engine": "^0.9.0",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
