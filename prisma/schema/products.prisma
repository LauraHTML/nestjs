model Product {
    id          Int        @id @default(autoincrement())
    name        String
    idCategory  Int
    price       Int
    stock       Int
    description String
    variants    Variants[]

    //relação
    category Categories @relation(fields: [idCategory], references: [id])
}

model Variants {
    id          Int    @id @default(autoincrement())
    idProduct   Int
    color       String
    stock       Int
    variantCode Int

    //relação
    product    Product      @relation(fields: [idProduct], references: [id])
    ordertItem OrderItens[]
}

model Categories {
    id           Int       @id @default(autoincrement())
    categoryName String
    description  String
    products     Product[]
}
